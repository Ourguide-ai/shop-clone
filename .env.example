# Public: loaded in the browser.
NEXT_PUBLIC_CHATWOOT_BASE_URL=https://chatwoot-web-production-7087.up.railway.app
NEXT_PUBLIC_CHATWOOT_WEBSITE_TOKEN=eyjMPh359MKe7o2rpSrXYiQN
NEXT_PUBLIC_ARGIDE_AGENT_API_URL=https://dev.api.argide.ai
NEXT_PUBLIC_ARGIDE_AGENT_PRODUCT_ID=prod_27b58e4d-2715-4451-817c-f8d28088321e

# Server only. Never expose these to the browser.
# Chatwoot user access token (Profile settings), used to read the customer message and post the reply.
# Agent-bot tokens cannot read messages.
CHATWOOT_API_TOKEN=
# Id of the Chatwoot agent bot (Settings, then Bots) that the handoff and task-result messages are sent as.
CHATWOOT_ARGIDE_BOT_ID=
# ak_live_... key, used by /api/argide/claim.
ARGIDE_AGENT_API_KEY=

# Needed only for npm install: a classic GitHub token with read:packages, used by .npmrc for @ourguide-ai/agent.
# GITHUB_TOKEN=
